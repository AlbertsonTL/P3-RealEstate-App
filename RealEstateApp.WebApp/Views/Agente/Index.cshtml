@model IEnumerable<RealEstateApp.WebApp.ViewModels.Publico.PropiedadResumenViewModel>
@{
    ViewData["Title"] = "Panel de Agente";
    var lista = Model.ToList();
    var activas = lista.Count(p => p.Estado != RealEstateApp.Core.Domain.Enumeraciones.EstadoPropiedad.Vendida);
    var vendidas = lista.Count(p => p.Estado == RealEstateApp.Core.Domain.Enumeraciones.EstadoPropiedad.Vendida);
}

<!-- Agent welcome banner -->
<div class="hero-panel hero-panel--accent">
    <div class="hero-panel__decor hero-panel__decor--lg"></div>
    <div class="hero-panel__content d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="hero-panel__title hero-panel__title--tight">Bienvenido, Agente</h1>
            <p class="hero-panel__subtitle">Gestiona tus propiedades y clientes desde aquí</p>
        </div>
        <a asp-action="Mantenimiento" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill"></i> Mis propiedades
        </a>
    </div>
</div>

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Total</div>
                    <div class="stat-card-value">@lista.Count</div>
                    <div class="stat-card-sub">propiedades</div>
                </div>
                <div class="stat-card-icon stat-card-icon--accent">
                    <i class="bi bi-houses-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Disponibles</div>
                    <div class="stat-card-value stat-card-value--green">@activas</div>
                    <div class="stat-card-sub">activas</div>
                </div>
                <div class="stat-card-icon stat-card-icon--green">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Vendidas</div>
                    <div class="stat-card-value stat-card-value--red">@vendidas</div>
                    <div class="stat-card-sub">completadas</div>
                </div>
                <div class="stat-card-icon stat-card-icon--red">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick actions -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-lightning-charge-fill me-2 text-accent"></i>Acciones rápidas</div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="CrearPropiedad" class="btn btn-outline-primary d-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Nueva propiedad
                </a>
                <a asp-action="Mantenimiento" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bi bi-table"></i> Ver todas mis propiedades
                </a>
                <a asp-action="MiPerfil" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle"></i> Editar mi perfil
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-clock-history me-2 text-accent"></i>Últimas propiedades</div>
            <div class="card-body p-0">
                @if (!lista.Any())
                {
                    <div class="empty-state empty-state--compact"><i class="bi bi-houses empty-icon"></i><p>Sin propiedades.</p></div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                    @foreach (var p in lista.Take(4))
                    {
                        <li class="d-flex align-items-center justify-content-between px-4 py-2 border-bottom">
                            <div class="list-item-title">@p.TipoPropiedad</div>
                            <span class="price-value price-value--sm price-value--accent">RD$ @p.Precio.ToString("N0")</span>
                        </li>
                    }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
