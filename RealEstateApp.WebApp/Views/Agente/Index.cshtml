@model IEnumerable<RealEstateApp.WebApp.ViewModels.Publico.PropiedadResumenViewModel>
@{
    ViewData["Title"] = "Panel de Agente";
    var lista = Model.ToList();
    var activas = lista.Count(p => p.Estado != RealEstateApp.Core.Domain.Enumeraciones.EstadoPropiedad.Vendida);
    var vendidas = lista.Count(p => p.Estado == RealEstateApp.Core.Domain.Enumeraciones.EstadoPropiedad.Vendida);
}

<!-- Agent welcome banner -->
<div style="background:linear-gradient(135deg,rgba(79,70,229,0.08) 0%,var(--surface) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);padding:2rem;margin-bottom:1.75rem;position:relative;overflow:hidden;">
    <div style="position:absolute;right:-40px;top:-40px;width:140px;height:140px;border-radius:50%;background:var(--accent-soft);opacity:0.5;"></div>
    <div style="position:relative;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <h1 style="font-size:1.5rem;margin:0 0 0.3rem;">Bienvenido, Agente</h1>
            <p style="color:var(--text-2);margin:0;font-size:0.9rem;">Gestiona tus propiedades y clientes desde aquí</p>
        </div>
        <a asp-action="Mantenimiento" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill"></i> Mis propiedades
        </a>
    </div>
</div>

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Total</div>
                    <div class="stat-card-value">@lista.Count</div>
                    <div class="stat-card-sub">propiedades</div>
                </div>
                <div class="stat-card-icon" style="background:var(--accent-soft);color:var(--accent);">
                    <i class="bi bi-houses-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Disponibles</div>
                    <div class="stat-card-value" style="color:var(--green);">@activas</div>
                    <div class="stat-card-sub">activas</div>
                </div>
                <div class="stat-card-icon" style="background:var(--green-soft);color:var(--green);">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Vendidas</div>
                    <div class="stat-card-value" style="color:var(--red);">@vendidas</div>
                    <div class="stat-card-sub">completadas</div>
                </div>
                <div class="stat-card-icon" style="background:var(--red-soft);color:var(--red);">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick actions -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-lightning-charge-fill me-2" style="color:var(--accent);"></i>Acciones rápidas</div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-action="CrearPropiedad" class="btn btn-outline-primary d-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Nueva propiedad
                </a>
                <a asp-action="Mantenimiento" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bi bi-table"></i> Ver todas mis propiedades
                </a>
                <a asp-action="MiPerfil" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle"></i> Editar mi perfil
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-clock-history me-2" style="color:var(--accent);"></i>Últimas propiedades</div>
            <div class="card-body p-0">
                @if (!lista.Any())
                {
                    <div class="empty-state" style="padding:2rem;"><i class="bi bi-houses empty-icon"></i><p>Sin propiedades.</p></div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                    @foreach (var p in lista.Take(4))
                    {
                        <li class="d-flex align-items-center justify-content-between px-4 py-2 border-bottom" style="border-color:var(--border) !important;">
                            <div style="font-size:0.875rem;font-weight:600;">@p.TipoPropiedad</div>
                            <span style="font-family:'Outfit',sans-serif;font-size:0.875rem;font-weight:700;color:var(--accent);">RD$ @p.Precio.ToString("N0")</span>
                        </li>
                    }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>