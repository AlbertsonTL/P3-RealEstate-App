@model RealEstateApp.WebApp.ViewModels.Agente.OfertasClientesViewModel
@{
    ViewData["Title"] = "Ofertas de clientes";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Mantenimiento" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <div>
        <h1 class="page-title">Ofertas de clientes</h1>
        <p class="page-subtitle">Clientes con ofertas en esta propiedad</p>
    </div>
</div>

@if (!Model.Clientes.Any())
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-currency-dollar empty-icon"></i>
            <p>No hay ofertas para esta propiedad aún.</p>
        </div>
    </div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <ul class="list-unstyled mb-0">
            @{int idx = 0;}
            @foreach (var cliente in Model.Clientes)
            {
                <li class="d-flex align-items-center justify-content-between px-4 py-3 @(idx++ < Model.Clientes.Count() - 1 ? "border-bottom" : "")">

                    @* Avatar + info *@
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(cliente.UrlFoto))
                        {
                            <img src="@cliente.UrlFoto"
                                 alt="Foto de @cliente.NombreCompleto"
                                 class="avatar-img avatar-44 avatar-img--bordered" />
                        }
                        else
                        {
                            <div class="icon-badge icon-badge-44 icon-badge--green">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        <div>
                            <div class="client-name">@cliente.NombreCompleto</div>
                            <div class="client-username">@cliente.NombreUsuario</div>
                        </div>
                    </div>

                    <a asp-action="OfertasDeCliente"
                       asp-route-propiedadId="@Model.PropiedadId"
                       asp-route-clienteId="@cliente.Id"
                       class="btn btn-sm btn-outline-success d-flex align-items-center gap-2">
                        <i class="bi bi-cash-stack"></i> Ver ofertas
                    </a>
                </li>
            }
            </ul>
        </div>
    </div>
}
