@model RealEstateApp.WebApp.ViewModels.Agente.OfertasDeClienteViewModel
@using RealEstateApp.Core.Domain.Enumeraciones
@{
    ViewData["Title"] = "Ofertas del cliente";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="OfertasClientes" asp-route-propiedadId="@Model.PropiedadId" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 style="font-size:1.4rem;margin:0;">Ofertas del cliente</h1>
        <p style="font-size:0.85rem;color:var(--text-3);margin:0;">Historial de ofertas para esta propiedad</p>
    </div>
</div>

@if (TempData["Exito"] is string exito) { <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@exito</div> }

@if (!Model.Ofertas.Any())
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-cash-stack empty-icon"></i>
            <p>Este cliente no tiene ofertas registradas.</p>
        </div>
    </div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Fecha</th><th>Cifra ofertada</th><th>Estado</th><th class="text-end pe-4">Acciones</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var oferta in Model.Ofertas)
                    {
                        <tr>
                            <td style="color:var(--text-2);font-size:0.875rem;">@oferta.FechaOferta.ToLocalTime().ToString("g")</td>
                            <td style="font-family:'Outfit',sans-serif;font-weight:700;font-size:0.95rem;">
                                RD$ @oferta.CifraOfertada.ToString("N2")
                            </td>
                            <td>
                                @{
                                    var (cls, icon) = oferta.Estado switch {
                                        EstadoOferta.Pendiente  => ("text-bg-warning", "bi-clock"),
                                        EstadoOferta.Aceptada  => ("text-bg-success", "bi-check-circle"),
                                        EstadoOferta.Rechazada => ("text-bg-danger",  "bi-x-circle"),
                                        _                       => ("text-bg-secondary","bi-dash")
                                    };
                                }
                                <span class="badge @cls"><i class="bi @icon me-1"></i>@oferta.Estado</span>
                            </td>
                            <td class="text-end pe-4">
                                @if (oferta.Estado == EstadoOferta.Pendiente)
                                {
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="AceptarOferta" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ofertaId"   value="@oferta.Id" />
                                            <input type="hidden" name="propiedadId" value="@Model.PropiedadId" />
                                            <input type="hidden" name="clienteId"   value="@Model.ClienteId" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-lg me-1"></i>Aceptar
                                            </button>
                                        </form>
                                        <form asp-action="RechazarOferta" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ofertaId"   value="@oferta.Id" />
                                            <input type="hidden" name="propiedadId" value="@Model.PropiedadId" />
                                            <input type="hidden" name="clienteId"   value="@Model.ClienteId" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-x-lg me-1"></i>Rechazar
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}