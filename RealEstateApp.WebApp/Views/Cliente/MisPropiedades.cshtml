@model RealEstateApp.WebApp.ViewModels.Publico.HomeViewModel
@{
    ViewData["Title"] = "Mis Favoritos";
    var lista = Model.Propiedades;
}

<!-- Client header banner -->
<div style="background:linear-gradient(135deg,var(--accent-soft) 0%,var(--surface) 100%);border:1px solid var(--border);border-radius:var(--radius-xl);padding:2rem;margin-bottom:1.75rem;position:relative;overflow:hidden;">
    <div style="position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;background:var(--accent-soft);opacity:0.6;"></div>
    <div style="position:relative;">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-heart-fill" style="color:var(--accent);font-size:1.1rem;"></i>
            <h1 style="font-size:1.5rem;margin:0;">Mis propiedades favoritas</h1>
        </div>
        <p style="font-size:0.875rem;color:var(--text-2);margin:0;">
            @lista.Count propiedad@(lista.Count != 1 ? "es" : "") guardada@(lista.Count != 1 ? "s" : "")
        </p>
    </div>
</div>

<partial name="_PanelFiltros" model="Model.Filtros" />

@if (!lista.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <i class="bi bi-house-heart empty-icon"></i>
                <p style="font-weight:600;color:var(--text-2);font-size:1rem;margin-bottom:0.5rem;">Aún no tienes favoritos</p>
                <p>Explora propiedades y guarda las que más te interesen.</p>
                <a asp-controller="Inicio" asp-action="Index" class="btn btn-primary mt-2">
                    <i class="bi bi-search me-1"></i>Explorar propiedades
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        @foreach (var p in lista)
        {
            <div class="col">
                <partial name="_TarjetaPropiedad" model="p" />
            </div>
        }
    </div>
}
