@model RealEstateApp.WebApp.ViewModels.Publico.HomeViewModel
@{
    ViewData["Title"] = "Mis Favoritos";
    var lista = Model.Propiedades;
}

<!-- Client header banner -->
<div class="hero-panel hero-panel--accent">
    <div class="hero-panel__decor hero-panel__decor--md"></div>
    <div class="hero-panel__content">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-heart-fill text-accent hero-panel__icon"></i>
            <h1 class="hero-panel__title">Mis propiedades favoritas</h1>
        </div>
        <p class="hero-panel__subtitle">
            @lista.Count propiedad@(lista.Count != 1 ? "es" : "") guardada@(lista.Count != 1 ? "s" : "")
        </p>
    </div>
</div>

<partial name="_PanelFiltros" model="Model.Filtros" />

@if (!lista.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <i class="bi bi-house-heart empty-icon"></i>
                <p class="empty-state__title">Aún no tienes favoritos</p>
                <p>Explora propiedades y guarda las que más te interesen.</p>
                <a asp-controller="Inicio" asp-action="Index" class="btn btn-primary mt-2">
                    <i class="bi bi-search me-1"></i>Explorar propiedades
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        @foreach (var p in lista)
        {
            <div class="col">
                <partial name="_TarjetaPropiedad" model="p" />
            </div>
        }
    </div>
}
