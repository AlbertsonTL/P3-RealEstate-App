@model RealEstateApp.WebApp.ViewModels.Cuenta.RestablecerContrasenaViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_Layout";
}

<style>
    .auth-page {
        min-height: calc(100vh - 72px);
        display: flex; align-items: center; justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, var(--bg) 0%, var(--surface-2) 100%);
    }
    .auth-container { width: 100%; max-width: 440px; }
    .auth-logo { text-align: center; margin-bottom: 2rem; }
    .auth-logo-icon {
        width: 64px; height: 64px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: #fff; margin-bottom: .75rem;
    }
    .auth-logo-icon img {
        width: 100%; height: 100%; object-fit: contain; display: block;
    }
    .auth-logo h1 { font-size: 1.5rem; font-weight: 700; color: var(--text-1); margin: 0; letter-spacing: -.02em; }
    .auth-logo p { color: var(--text-3); font-size: .875rem; margin: .25rem 0 0; }
    .auth-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius-xl); padding: 2rem; box-shadow: var(--shadow-lg);
    }
    .auth-card .form-label { font-size: .8125rem; font-weight: 600; color: var(--text-2); margin-bottom: .375rem; }
    .input-wrap { position: relative; }
    .input-wrap .form-control { padding-right: 2.75rem; }
    .auth-card .form-control {
        background: var(--surface-2); border: 1.5px solid var(--border-strong);
        border-radius: var(--radius-sm); color: var(--text-1); font-size: .9375rem; height: 46px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .auth-card .form-control:focus {
        background: var(--surface); border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(41,83,224,.12); outline: none;
    }
    .btn-eye {
        position: absolute; right: .75rem; top: 50%; transform: translateY(-50%);
        background: none; border: none; padding: 0; color: var(--text-3);
        cursor: pointer; font-size: 1rem; line-height: 1;
        display: flex; align-items: center; transition: color .15s; z-index: 5;
    }
    .btn-eye:hover { color: var(--accent); }
    .btn-auth-primary {
        width: 100%; height: 46px; background: var(--accent); color: #fff;
        border: none; border-radius: var(--radius-sm);
        font-size: .9375rem; font-weight: 600;
        cursor: pointer; transition: background .2s, transform .1s, box-shadow .2s;
        box-shadow: 0 4px 14px rgba(41,83,224,.28);
        display: flex; align-items: center; justify-content: center; gap: .5rem;
    }
    .btn-auth-primary:hover { background: var(--accent-h); box-shadow: 0 6px 18px rgba(41,83,224,.38); }
    .btn-auth-primary:active { transform: scale(.98); }
    .alert-auth {
        background: var(--red-soft); border: 1px solid rgba(220,38,38,.2);
        border-radius: var(--radius-sm); color: var(--red-text);
        padding: .75rem 1rem; font-size: .875rem;
        display: flex; align-items: flex-start; gap: .5rem; margin-bottom: 1.25rem;
    }
    .text-danger { font-size: .75rem; margin-top: .25rem; display: block; }
    .back-link {
        display: flex; align-items: center; gap: .375rem;
        font-size: .875rem; color: var(--text-3); text-decoration: none;
        margin-top: 1.25rem; justify-content: center; transition: color .15s;
    }
    .back-link:hover { color: var(--accent); }
    .pass-strength { height: 4px; border-radius: 2px; margin-top: .375rem; background: var(--border); overflow: hidden; }
    .pass-strength-bar { height: 100%; width: 0; border-radius: 2px; transition: width .3s, background .3s; }
</style>

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-logo">
            <div class="auth-logo-icon"><img src="~/logo.png" alt="RealEstateApp logo" /></div>
            <h1>Nueva contraseña</h1>
            <p>Elige una contraseña segura para tu cuenta</p>
        </div>
        <div class="auth-card">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert-auth">
                    <i class="bi bi-exclamation-circle-fill" style="margin-top:1px;flex-shrink:0;"></i>
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="RestablecerContrasena" method="post" novalidate>
                <input asp-for="UsuarioId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NuevaContrasena" class="form-label">Nueva contraseña</label>
                    <div class="input-wrap">
                        <input asp-for="NuevaContrasena" id="inpNuevaPass" type="password"
                               class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="btn-eye" id="btnEye1" aria-label="Ver contraseña">
                            <i class="bi bi-eye" id="eye1"></i>
                        </button>
                    </div>
                    <div class="pass-strength"><div class="pass-strength-bar" id="strengthBar"></div></div>
                    <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña</label>
                    <div class="input-wrap">
                        <input asp-for="ConfirmarContrasena" id="inpConfirmaPass" type="password"
                               class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="btn-eye" id="btnEye2" aria-label="Ver contraseña">
                            <i class="bi bi-eye" id="eye2"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth-primary">
                    <i class="bi bi-check-circle-fill"></i> Restablecer contraseña
                </button>
            </form>
        </div>
        <a asp-action="Login" class="back-link">
            <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
        </a>
    </div>
</div>

@section Scripts {
<script>
(function(){
    function toggle(inpId, iconId){
        var inp = document.getElementById(inpId);
        var ico = document.getElementById(iconId);
        return function(){
            if(inp.type==='password'){ inp.type='text'; ico.classList.replace('bi-eye','bi-eye-slash'); }
            else { inp.type='password'; ico.classList.replace('bi-eye-slash','bi-eye'); }
        };
    }
    document.getElementById('btnEye1').addEventListener('click', toggle('inpNuevaPass','eye1'));
    document.getElementById('btnEye2').addEventListener('click', toggle('inpConfirmaPass','eye2'));

    // Password strength indicator
    document.getElementById('inpNuevaPass').addEventListener('input', function(){
        var v = this.value, bar = document.getElementById('strengthBar');
        var score = 0;
        if(v.length >= 6) score++;
        if(v.length >= 10) score++;
        if(/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
        if(/[0-9]/.test(v)) score++;
        if(/[^A-Za-z0-9]/.test(v)) score++;
        var pct = [0,25,50,70,85,100][score];
        var clr = ['','#ef4444','#f97316','#eab308','#22c55e','#16a34a'][score];
        bar.style.width = pct+'%';
        bar.style.background = clr;
    });
})();
</script>
<partial name="_ValidationScriptsPartial" />
}
