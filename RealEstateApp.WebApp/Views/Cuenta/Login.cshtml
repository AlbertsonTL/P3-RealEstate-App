@model RealEstateApp.WebApp.ViewModels.Cuenta.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-logo">
            <div class="auth-logo-icon"><img src="~/logo.png" alt="RealEstateApp logo" /></div>
            <h1>Bienvenido de nuevo</h1>
            <p>Ingresa tus credenciales para continuar</p>
        </div>
        <div class="auth-card">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alert-success-auth">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@exito</span>
                </div>
            }
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert-auth">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }
            <form asp-action="Login" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="UsuarioOCorreo" class="form-label">Usuario o correo</label>
                    <div class="input-wrap">
                        <input asp-for="UsuarioOCorreo" class="form-control"
                               placeholder="tu@correo.com o usuario" autocomplete="username" />
                    </div>
                </div>
                <div class="mb-1">
                    <label asp-for="Contrasena" class="form-label">Contraseña</label>
                    <div class="input-wrap">
                        <input asp-for="Contrasena" id="inpLoginPass" type="password"
                               class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="btn-eye" id="btnLoginEye" aria-label="Ver contraseña">
                            <i class="bi bi-eye" id="loginEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div class="remember-row mb-3 mt-2">
                    <div class="form-check mb-0">
                        <input asp-for="RecordarSesion" class="form-check-input" id="recuerdame" />
                        <label class="form-check-label" for="recuerdame">Recuérdame</label>
                    </div>
                    <a asp-action="RecuperarContrasena" class="forgot-link">¿Olvidaste tu contraseña?</a>
                </div>
                <button type="submit" class="btn-auth-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                </button>
            </form>
        </div>
        <div class="auth-footer">
            ¿No tienes cuenta? <a asp-action="Registro">Regístrate gratis</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    var inp = document.getElementById('inpLoginPass');
    var ico = document.getElementById('loginEyeIcon');
    document.getElementById('btnLoginEye').addEventListener('click', function(){
        if(inp.type==='password'){ inp.type='text'; ico.classList.replace('bi-eye','bi-eye-slash'); }
        else { inp.type='password'; ico.classList.replace('bi-eye-slash','bi-eye'); }
    });
})();
</script>
<partial name="_ValidationScriptsPartial" />
}
