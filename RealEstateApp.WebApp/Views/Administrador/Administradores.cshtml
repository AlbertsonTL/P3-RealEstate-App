@model List<RealEstateApp.Infrastructure.Identity.Entidades.UsuarioAplicacion>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Administradores"; }

<div class="admin-page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
    <div><h1>Administradores</h1><p class="page-sub">Gestiona los usuarios con rol de administrador</p></div>
    <span class="badge text-bg-primary align-self-center fs-6 px-3 py-2">@Model.Count registros</span>
</div>
@if (TempData["Exito"] is string exito) { <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@exito</div> }
@if (TempData["Error"]  is string error) { <div class="alert alert-danger  mb-3"><i class="bi bi-x-circle me-2"></i>@error</div> }

<div class="card mb-3">
    <div class="card-header"><i class="bi bi-person-plus me-2"></i>Crear administrador</div>
    <div class="card-body">
        <form asp-action="CrearAdministrador" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                <div class="col-md-3"><label class="form-label">Nombre</label><input class="form-control" name="Nombre" placeholder="Nombre" required /></div>
                <div class="col-md-3"><label class="form-label">Apellido</label><input class="form-control" name="Apellido" placeholder="Apellido" required /></div>
                <div class="col-md-3"><label class="form-label">Cédula</label><input class="form-control" name="Cedula" placeholder="Cédula" required /></div>
                <div class="col-md-3"><label class="form-label">Teléfono</label><input class="form-control" name="Telefono" placeholder="Teléfono" required /></div>
                <div class="col-md-4"><label class="form-label">Correo</label><input type="email" class="form-control" name="Correo" placeholder="correo@ejemplo.com" required /></div>
                <div class="col-md-4"><label class="form-label">Usuario</label><input class="form-control" name="NombreUsuario" placeholder="nombre.usuario" required /></div>
                <div class="col-md-2"><label class="form-label">Contraseña</label><input type="password" class="form-control" name="Contrasena" required /></div>
                <div class="col-md-2"><label class="form-label">Confirmar</label><input type="password" class="form-control" name="ConfirmarContrasena" required /></div>
                <div class="col-12 text-end mt-1"><button type="submit" class="btn btn-primary"><i class="bi bi-plus me-1"></i>Crear</button></div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Nombre</th><th>Usuario</th><th>Correo</th><th>Cédula</th><th>Teléfono</th><th class="text-center">Estado</th><th class="text-end pe-4">Acciones</th></tr></thead>
                <tbody>
                @if (!Model.Any()) { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-shield-person empty-icon"></i><p>Sin administradores.</p></div></td></tr> }
                else {
                    var currentId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    @foreach (var admin in Model) {
                    var esSelf = admin.Id == currentId;
                    <tr>
                        <td><span style="font-weight:600;font-size:0.9rem;">@admin.Nombre @admin.Apellido</span></td>
                        <td style="color:var(--text-2);font-size:0.875rem;">@admin.UserName</td>
                        <td style="color:var(--text-2);font-size:0.875rem;">@admin.Email</td>
                        <td style="color:var(--text-3);font-size:0.875rem;">@admin.Cedula</td>
                        <td style="color:var(--text-3);font-size:0.875rem;">@admin.Telefono</td>
                        <td class="text-center">
                            <span class="badge @(admin.EstaActivo ? "text-bg-success" : "text-bg-secondary")">
                                @(admin.EstaActivo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                @if (!esSelf)
                                {
                                    <a asp-action="EditarAdministrador" asp-route-id="@admin.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="CambiarEstadoAdministrador" method="post" class="m-0">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@admin.Id" />
                                        <button type="submit" class="btn btn-sm @(admin.EstaActivo ? "btn-outline-warning" : "btn-outline-success")">
                                            @(admin.EstaActivo ? "Inactivar" : "Activar")
                                        </button>
                                    </form>
                                    <form asp-action="EliminarAdministrador" method="post" class="m-0" onsubmit="return confirm('¿Eliminar administrador?');">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@admin.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-action="MiPerfil" class="btn btn-sm btn-outline-secondary">Mi Perfil</a>
                                    <span class="badge text-bg-info align-self-center">Tú</span>
                                }
                            </div>
                        </td>
                    </tr>
                } }
                </tbody>
            </table>
        </div>
    </div>
</div>
