@model RealEstateApp.WebApp.ViewModels.Admin.DashboardViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard";
}

<div class="admin-page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1>Dashboard</h1>
        <p class="page-subtitle">Resumen general del sistema — @DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
    </div>
    <a asp-controller="Inicio" asp-action="Index" target="_blank"
       class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2">
        <i class="bi bi-box-arrow-up-right"></i> Ver sitio
    </a>
</div>

<!-- Stats Grid -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Propiedades</div>
                    <div class="stat-card-value">@Model.PropiedadesDisponibles</div>
                    <div class="stat-card-sub">disponibles · <span class="text-red">@Model.PropiedadesVendidas vendidas</span></div>
                </div>
                <div class="stat-card-icon stat-card-icon--accent">
                    <i class="bi bi-houses-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Agentes</div>
                    <div class="stat-card-value stat-card-value--green">@Model.AgentesActivos</div>
                    <div class="stat-card-sub">activos · <span class="text-muted">@Model.AgentesInactivos inactivos</span></div>
                </div>
                <div class="stat-card-icon stat-card-icon--green">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Clientes</div>
                    <div class="stat-card-value stat-card-value--blue">@Model.ClientesActivos</div>
                    <div class="stat-card-sub">activos · <span class="text-muted">@Model.ClientesInactivos inactivos</span></div>
                </div>
                <div class="stat-card-icon stat-card-icon--blue">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="stat-card-label">Desarrolladores</div>
                    <div class="stat-card-value stat-card-value--amber">@Model.DesarrolladoresActivos</div>
                    <div class="stat-card-sub">activos · <span class="text-muted">@Model.DesarrolladoresInactivos inactivos</span></div>
                </div>
                <div class="stat-card-icon stat-card-icon--amber">
                    <i class="bi bi-code-slash"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-lightning-charge-fill text-accent"></i>
                Acciones rápidas
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @{
                        // Variant reemplaza los antiguos campos "Color"/"IconColor" (que ya eran
                        // literalmente nombres de variables CSS escritos a mano en este mismo
                        // bloque @{ }). Con un conjunto cerrado de 6 combinaciones, el valor
                        // correcto es una clase semántica (.action-tile--{variant}), no CSS
                        // inline. No se tocó ningún ViewModel ni Servicio: este arreglo es
                        // 100% de presentación y vive solo en esta vista.
                        var actions = new[] {
                            new { Icon="bi-person-badge", Label="Gestionar Agentes",    Ctrl="Administrador", Act="Agentes",          Variant="accent"  },
                            new { Icon="bi-person", Label="Administradores",     Ctrl="Administrador", Act="Administradores",   Variant="green"   },
                            new { Icon="bi-house-gear",   Label="Tipos de Propiedad",   Ctrl="Administrador", Act="TiposPropiedades",  Variant="amber"   },
                            new { Icon="bi-tags",         Label="Tipos de Venta",       Ctrl="Administrador", Act="TiposVentas",       Variant="blue"    },
                            new { Icon="bi-stars",        Label="Mejoras",              Ctrl="Administrador", Act="Mejoras",           Variant="red"     },
                            new { Icon="bi-code-slash",   Label="Desarrolladores",      Ctrl="Administrador", Act="Desarrolladores",   Variant="neutral" },
                        };
                    }
                    @foreach (var a in actions)
                    {
                        <div class="col-sm-6 col-md-4">
                            <a asp-controller="@a.Ctrl" asp-action="@a.Act"
                               class="d-flex align-items-center gap-3 p-3 rounded-3 text-decoration-none action-tile action-tile--@a.Variant">
                                <div class="action-tile-icon-wrap">
                                    <i class="bi @a.Icon action-tile-icon--@a.Variant"></i>
                                </div>
                                <span class="action-tile-label">@a.Label</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-fill text-accent"></i>
                Totales del sistema
            </div>
            <div class="card-body p-0">
                @{
                    var total = Model.AgentesActivos + Model.AgentesInactivos + Model.ClientesActivos +
                                Model.ClientesInactivos + Model.DesarrolladoresActivos + Model.DesarrolladoresInactivos;
                    var totalProp = Model.PropiedadesDisponibles + Model.PropiedadesVendidas;
                }
                <ul class="list-unstyled mb-0">
                    @{
                        // Mismo caso que "actions": Variant sustituye el "Color" hardcodeado.
                        var rows = new[] {
                            new { Label="Total propiedades",  Val=totalProp.ToString(),  Variant="accent" },
                            new { Label="Total usuarios",     Val=total.ToString(),       Variant="blue"   },
                            new { Label="Tasa de venta",
                                  Val=(totalProp > 0 ? $"{(Model.PropiedadesVendidas * 100 / totalProp)}%" : "0%"),
                                  Variant="green" },
                            new { Label="Agentes/Propiedades",
                                  Val=(Model.AgentesActivos > 0 ? $"{(totalProp / Math.Max(Model.AgentesActivos,1)):0.0}/ag." : "—"),
                                  Variant="amber" },
                        };
                    }
                    @for(int i=0; i<rows.Length; i++) {
                        var r = rows[i];
                        <li class="d-flex justify-content-between align-items-center px-4 py-3 @(i < rows.Length-1 ? "border-bottom" : "")">
                            <span class="td-muted">@r.Label</span>
                            <span class="price-value price-value--row price-value--@(r.Variant)-row">@r.Val</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
