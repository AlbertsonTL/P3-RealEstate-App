@model List<RealEstateApp.WebApp.ViewModels.Admin.ListadoAgentesAdminViewModel>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Agentes";
}

<div class="admin-page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
    <div>
        <h1>Gestión de Agentes</h1>
        <p class="page-subtitle">Administra el estado y acceso de los agentes registrados</p>
    </div>
    <span class="badge text-bg-primary align-self-center fs-6 px-3 py-2">@Model.Count agentes</span>
</div>

@if (TempData["Exito"] is string exito) { <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@exito</div> }
@if (TempData["Error"]  is string error) { <div class="alert alert-danger  mb-3"><i class="bi bi-x-circle me-2"></i>@error</div> }

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Agente</th>
                        <th>Correo</th>
                        <th>Propiedades</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5">
                        <div class="empty-state">
                            <i class="bi bi-person-badge empty-icon"></i>
                            <p>No hay agentes registrados.</p>
                        </div>
                    </td></tr>
                }
                else
                {
                    @foreach (var agente in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="icon-badge icon-badge-34 icon-badge--accent">
                                        @agente.Nombre.FirstOrDefault()@agente.Apellido.FirstOrDefault()
                                    </div>
                                    <span class="td-strong">@agente.Nombre @agente.Apellido</span>
                                </div>
                            </td>
                            <td class="td-muted">@agente.Correo</td>
                            <td>
                                <span class="badge text-bg-primary">@agente.CantidadPropiedades</span>
                            </td>
                            <td>
                                <span class="badge @(agente.EstaActivo ? "text-bg-success" : "text-bg-secondary")">
                                    <i class="bi @(agente.EstaActivo ? "bi-circle-fill" : "bi-circle") me-1 badge-dot"></i>
                                    @(agente.EstaActivo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <form asp-action="CambiarEstadoAgente" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@agente.Id" />
                                        <button type="submit" class="btn btn-sm @(agente.EstaActivo ? "btn-outline-warning" : "btn-outline-success")">
                                            @(agente.EstaActivo ? "Inactivar" : "Activar")
                                        </button>
                                    </form>
                                    <form asp-action="EliminarAgente" method="post" class="m-0"
                                          data-confirmar-eliminar
                                          data-titulo-eliminar="Eliminar agente"
                                          data-mensaje-eliminar="¿Deseas eliminar este agente? Esta acción no se puede deshacer.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@agente.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
