@model RealEstateApp.WebApp.ViewModels.Admin.CatalogoFormViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Tipo de Venta";
}

<h2 class="mb-3">Editar Tipo de Venta</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="EditarTipoVenta" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="TiposVentas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
