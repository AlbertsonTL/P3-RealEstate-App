@using RealEstateApp.WebApp.ViewModels.Shared

@{
    var perfil      = (EditarPerfilViewModel)ViewBag.PerfilViewModel;
    var contrasena  = (CambiarContrasenaViewModel)ViewBag.ContrasenaViewModel;
    var seccion     = (string?)ViewBag.SeccionActiva ?? "perfil";
    var controller  = ViewContext.RouteData.Values["controller"]?.ToString();
}

@* Alertas de éxito / error *@
@if (TempData["Exito"] is string msgOk)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <span>@msgOk</span>
    </div>
}
@if (TempData["Error"] is string msgErr)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <span>@msgErr</span>
    </div>
}

@* Cabecera *@
<div class="d-flex align-items-center gap-3 mb-4">
    <div>
        <h1 style="font-size:1.4rem;margin:0;">Mi Perfil</h1>
        <p style="font-size:0.85rem;color:var(--text-3);margin:0;">
            Actualiza tu información personal y tu contraseña
        </p>
    </div>
</div>

@* Tabs *@
<ul class="nav nav-tabs mb-4" id="perfilTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(seccion == "perfil" ? "active" : "")"
                id="tab-perfil"
                data-bs-toggle="tab"
                data-bs-target="#panel-perfil"
                type="button" role="tab">
            <i class="bi bi-person-lines-fill me-1"></i>Datos personales
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(seccion == "contrasena" ? "active" : "")"
                id="tab-contrasena"
                data-bs-toggle="tab"
                data-bs-target="#panel-contrasena"
                type="button" role="tab">
            <i class="bi bi-shield-lock me-1"></i>Contraseña
        </button>
    </li>
</ul>

<div class="tab-content" id="perfilTabsContent">

    @* PANEL 1 — Datos personales *@
    <div class="tab-pane fade @(seccion == "perfil" ? "show active" : "")"
         id="panel-perfil" role="tabpanel">

        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-person-circle me-2"></i>Información personal
                    </div>
                    <div class="card-body">

                        @* Vista previa de foto actual *@
                        @if (!string.IsNullOrEmpty(perfil.UrlFotoActual))
                        {
                            <div class="text-center mb-4">
                                <img src="@perfil.UrlFotoActual"
                                     alt="Foto de perfil"
                                     class="rounded-circle border"
                                     style="width:90px;height:90px;object-fit:cover;" />
                                <p class="text-muted small mt-1 mb-0">Foto actual</p>
                            </div>
                        }

                        <form asp-controller="@controller"
                              asp-action="EditarPerfil"
                              method="post"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="row g-3">

                                @* Nombre *@
                                <div class="col-md-6">
                                    <label class="form-label" for="perfil_Nombre">Nombre</label>
                                    <input id="perfil_Nombre"
                                           name="Nombre"
                                           value="@perfil.Nombre"
                                           class="form-control @(ViewData.ModelState["Nombre"]?.Errors.Any() == true ? "is-invalid" : "")"
                                           placeholder="Tu nombre" />
                                    @if (ViewData.ModelState["Nombre"]?.Errors.Any() == true && seccion == "perfil")
                                    {
                                        <div class="invalid-feedback">
                                            @ViewData.ModelState["Nombre"]!.Errors.First().ErrorMessage
                                        </div>
                                    }
                                </div>

                                @* Apellido *@
                                <div class="col-md-6">
                                    <label class="form-label" for="perfil_Apellido">Apellido</label>
                                    <input id="perfil_Apellido"
                                           name="Apellido"
                                           value="@perfil.Apellido"
                                           class="form-control @(ViewData.ModelState["Apellido"]?.Errors.Any() == true ? "is-invalid" : "")"
                                           placeholder="Tu apellido" />
                                    @if (ViewData.ModelState["Apellido"]?.Errors.Any() == true && seccion == "perfil")
                                    {
                                        <div class="invalid-feedback">
                                            @ViewData.ModelState["Apellido"]!.Errors.First().ErrorMessage
                                        </div>
                                    }
                                </div>

                                @* Teléfono *@
                                <div class="col-md-6">
                                    <label class="form-label" for="perfil_Telefono">Teléfono</label>
                                    <input id="perfil_Telefono"
                                           name="Telefono"
                                           value="@perfil.Telefono"
                                           class="form-control @(ViewData.ModelState["Telefono"]?.Errors.Any() == true ? "is-invalid" : "")"
                                           placeholder="+1 (809) 000-0000" />
                                    @if (ViewData.ModelState["Telefono"]?.Errors.Any() == true && seccion == "perfil")
                                    {
                                        <div class="invalid-feedback">
                                            @ViewData.ModelState["Telefono"]!.Errors.First().ErrorMessage
                                        </div>
                                    }
                                </div>

                                @* ── CORREO ELECTRÓNICO (nuevo) ── *@
                                <div class="col-md-6">
                                    <label class="form-label" for="perfil_Email">Correo electrónico</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-envelope"></i>
                                        </span>
                                        <input id="perfil_Email"
                                               name="Email"
                                               type="email"
                                               value="@perfil.Email"
                                               autocomplete="email"
                                               class="form-control @(ViewData.ModelState["Email"]?.Errors.Any() == true ? "is-invalid" : "")"
                                               placeholder="tucorreo@ejemplo.com" />
                                        @if (ViewData.ModelState["Email"]?.Errors.Any() == true && seccion == "perfil")
                                        {
                                            <div class="invalid-feedback">
                                                @ViewData.ModelState["Email"]!.Errors.First().ErrorMessage
                                            </div>
                                        }
                                    </div>
                                    <p class="form-text" style="color:var(--text-3);font-size:0.78rem;margin-top:0.25rem;">
                                        Si cambias tu correo tendrás que usarlo para iniciar sesión.
                                    </p>
                                </div>

                                @* Foto *@
                                <div class="col-12">
                                    <label class="form-label" for="perfil_FotoUsuario">
                                        Foto de perfil
                                        <span class="text-muted small fw-normal">(opcional)</span>
                                    </label>
                                    <input id="perfil_FotoUsuario"
                                           name="FotoUsuario"
                                           type="file"
                                           accept="image/*"
                                           class="form-control"
                                           onchange="previsualizarFoto(this)" />
                                    <p class="form-text" style="color:var(--text-3);font-size:0.78rem;margin-top:0.25rem;">
                                        Formatos: JPG, PNG, WEBP. Máximo 2 MB.
                                    </p>
                                    <img id="preview-foto"
                                         src="#"
                                         alt="Vista previa"
                                         class="rounded-circle border mt-1 d-none"
                                         style="width:70px;height:70px;object-fit:cover;" />
                                </div>

                                <div class="col-12 pt-1">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-lg me-1"></i>Guardar cambios
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* PANEL 2 — Cambiar contraseña *@
    <div class="tab-pane fade @(seccion == "contrasena" ? "show active" : "")"
         id="panel-contrasena" role="tabpanel">

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-shield-lock me-2"></i>Cambiar contraseña
                    </div>
                    <div class="card-body">
                        <form asp-controller="@controller"
                              asp-action="CambiarContrasena"
                              method="post">
                            @Html.AntiForgeryToken()

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="cp_Actual">Contraseña actual</label>
                                    <input id="cp_Actual"
                                           name="ContrasenaActual"
                                           type="password"
                                           autocomplete="current-password"
                                           class="form-control @(ViewData.ModelState["ContrasenaActual"]?.Errors.Any() == true ? "is-invalid" : "")"
                                           placeholder="••••••••" />
                                    @if (ViewData.ModelState["ContrasenaActual"]?.Errors.Any() == true && seccion == "contrasena")
                                    {
                                        <div class="invalid-feedback">
                                            @ViewData.ModelState["ContrasenaActual"]!.Errors.First().ErrorMessage
                                        </div>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="cp_Nueva">Nueva contraseña</label>
                                    <input id="cp_Nueva"
                                           name="NuevaContrasena"
                                           type="password"
                                           autocomplete="new-password"
                                           class="form-control @(ViewData.ModelState["NuevaContrasena"]?.Errors.Any() == true ? "is-invalid" : "")"
                                           placeholder="Mínimo 6 caracteres" />
                                    @if (ViewData.ModelState["NuevaContrasena"]?.Errors.Any() == true && seccion == "contrasena")
                                    {
                                        <div class="invalid-feedback">
                                            @ViewData.ModelState["NuevaContrasena"]!.Errors.First().ErrorMessage
                                        </div>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="cp_Confirmar">Confirmar nueva contraseña</label>
                                    <input id="cp_Confirmar"
                                           name="ConfirmarContrasena"
                                           type="password"
                                           autocomplete="new-password"
                                           class="form-control @(ViewData.ModelState["ConfirmarContrasena"]?.Errors.Any() == true ? "is-invalid" : "")"
                                           placeholder="Repite la nueva contraseña" />
                                    @if (ViewData.ModelState["ConfirmarContrasena"]?.Errors.Any() == true && seccion == "contrasena")
                                    {
                                        <div class="invalid-feedback">
                                            @ViewData.ModelState["ConfirmarContrasena"]!.Errors.First().ErrorMessage
                                        </div>
                                    }
                                </div>

                                <div class="col-12 pt-1">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-lock me-1"></i>Cambiar contraseña
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function previsualizarFoto(input) {
            var preview = document.getElementById('preview-foto');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
