@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgery = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="es" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@antiforgery.RequestToken" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEstateApp.WebApp.styles.css" asp-append-version="true" />
    <script>
            (function () {
                var t = localStorage.getItem('re-theme') || 'light';
                document.documentElement.setAttribute('data-theme', t);
            })();
    </script>
</head>

<body>
    <header class="main-navbar">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand navbar-brand-text" asp-controller="Inicio" asp-action="Index">
                    <span class="navbar-brand-icon"><img src="~/logo.png" alt="RealEstateApp logo" /></span>
                    RealEstate
                </a>
                <div class="d-flex align-items-center gap-2 d-lg-none">
                    <button class="btn-theme-toggle" id="themeToggleMobile" aria-label="Cambiar tema">
                        <i class="bi bi-sun-fill icon-sun"></i>
                        <i class="bi bi-moon-fill icon-moon"></i>
                    </button>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#menuPrincipal">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div id="menuPrincipal" class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Inicio" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Agentes" asp-action="Index">Agentes</a>
                        </li>

                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro">Únete</a>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <a class="nav-link btn-nav-cta" asp-controller="Cuenta" asp-action="Login">Entrar</a>
                            </li>
                        }
                        else
                        {
                            @* ── Acceso rápido por rol ── *@
                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cliente" asp-action="MisPropiedades">
                                        <i class="bi bi-heart me-1"></i>Favoritos
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Agente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agente" asp-action="Mantenimiento">
                                        <i class="bi bi-grid me-1"></i>Propiedades
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrador" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Desarrollador"))
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-muted"><i class="bi bi-code-slash me-1"></i>Dev</span>
                                </li>
                            }

                            @* ── Dropdown "Mi cuenta" (Mi Perfil + Salir) ── *@
                            <li class="nav-item dropdown ms-lg-1">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                    <span class="d-none d-lg-inline">Mi cuenta</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @* Enlace a Mi Perfil según el rol activo *@
                                    @if (User.IsInRole("Agente"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Agente" asp-action="MiPerfil">
                                                <i class="bi bi-person-gear me-2"></i>Mi Perfil
                                            </a>
                                        </li>
                                    }
                                    else if (User.IsInRole("Cliente"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Cliente" asp-action="MiPerfil">
                                                <i class="bi bi-person-gear me-2"></i>Mi Perfil
                                            </a>
                                        </li>
                                    }
                                    else if (User.IsInRole("Administrador"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Administrador" asp-action="MiPerfil">
                                                <i class="bi bi-person-gear me-2"></i>Mi Perfil
                                            </a>
                                        </li>
                                    }
                                    else if (User.IsInRole("Desarrollador"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Desarrollador" asp-action="MiPerfil">
                                                <i class="bi bi-person-gear me-2"></i>Mi Perfil
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post"
                                              class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item ms-lg-2 d-none d-lg-flex align-items-center">
                            <button class="btn-theme-toggle" id="themeToggleDesktop" aria-label="Cambiar tema">
                                <i class="bi bi-sun-fill icon-sun"></i>
                                <i class="bi bi-moon-fill icon-moon"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="footer-main mt-5 py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="navbar-brand-icon" style="width:36px;height:36px;font-size:0.8rem;">
                            <img src="~/logo.png" alt="RealEstateApp logo" style="width:100%;height:100%;object-fit:contain;" />
                        </span>
                        <span
                            style="font-family:'Outfit',sans-serif;font-weight:800;font-size:0.95rem;color:var(--text-1);">RealEstateApp</span>
                    </div>
                        <p class="text-muted small mb-0">Tu mejor aliado en la búsqueda de propiedades en República
                            Dominicana.</p>
                        </div>
                        <div class="col-md-4">
                            <h6 class="fw-bold mb-3">Navegación</h6>
                            <ul class="list-unstyled mb-0">
                                <li class="mb-1"><a asp-controller="Inicio" asp-action="Index"
                                                        class="text-muted small text-decoration-none">Inicio</a></li>
                                    <li class="mb-1"><a asp-controller="Agentes" asp-action="Index"
                                                            class="text-muted small text-decoration-none">Agentes</a></li>
                                    </ul>
                                </div>
                                <div class="col-md-4">
                                    <h6 class="fw-bold mb-3">Contacto</h6>
                                    <p class="text-muted small mb-1"><i class="bi bi-envelope me-2"></i>soporte@realestateapp.com</p>
                                    <p class="text-muted small mb-0"><i class="bi bi-telephone me-2"></i>+1 (809) 000-0000</p>
                                </div>
                            </div>
                            <hr style="border-color:var(--border); margin-top:2rem;">
                            <p class="text-muted small text-center mb-0">&copy; @DateTime.Now.Year RealEstateApp — Todos los derechos
                                reservados.</p>
                            </div>
                        </footer>

                        <script src="~/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
                        <script src="~/js/site.js" asp-append-version="true"></script>
                        <script>
                                (function () {
                                    function setTheme(t) {
                                        document.documentElement.setAttribute('data-theme', t);
                                        localStorage.setItem('re-theme', t);
                                    }
                                    function toggle() {
                                        var cur = document.documentElement.getAttribute('data-theme') || 'light';
                                        setTheme(cur === 'dark' ? 'light' : 'dark');
                                    }
                                    var d = document.getElementById('themeToggleDesktop');
                                    var m = document.getElementById('themeToggleMobile');
                                    if (d) d.addEventListener('click', toggle);
                                    if (m) m.addEventListener('click', toggle);
                                })();
                        </script>
                        @await RenderSectionAsync("Scripts", required: false)
                    </body>

                </html>
