@model RealEstateApp.WebApp.ViewModels.Publico.FiltrosPropiedadViewModel

<form asp-controller="Inicio" asp-action="Index" method="get" class="filtros-panel">
    <div class="row g-2">
        <div class="col-md-3"><input asp-for="CodigoBusqueda" class="form-control" placeholder="Codigo" /></div>
        <div class="col-md-2"><select asp-for="TipoPropiedadId" asp-items="Model.TiposPropiedad" class="form-select"><option value="">Tipo</option></select></div>
        <div class="col-md-2"><input asp-for="PrecioMinimo" class="form-control" placeholder="Precio min" /></div>
        <div class="col-md-2"><input asp-for="PrecioMaximo" class="form-control" placeholder="Precio max" /></div>
        <div class="col-md-2"><input asp-for="CantidadHabitaciones" class="form-control" placeholder="Habitaciones" /></div>
        <!-- <div class="col-md-1"><input asp-for="CantidadBanos" class="form-control" placeholder="Baños" /></div> -->
        <div class="col-md-1 d-grid"><button class="btn btn-primario">Buscar</button></div>
    </div>
</form>
